{
  "Urls": "http://localhost:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Recording": {
    "StorageDirectory": "recordings",
    "Format": "MpegTs",
    "Rotation": {
      "SegmentDuration": "00:10:00",
      "MaxSegmentSizeMB": 512
    },
    "RetentionInterval": "00:01:00",
    "StallTimeout": "00:00:15",
    "MinReconnectDelay": "00:00:01",
    "MaxReconnectDelay": "00:01:00"
  },
  "Plugins": {
    "Directory": "plugins",
    "FrameQueueCapacity": 32,
    "EventHistory": 1000,
    "StopTimeout": "00:00:10"
  },
  "Database": {
    "Provider": "PostgreSql",
    "ConnectionString": "Host=db.example.local;Database=onvif;Username=onvif;Password=change-me"
  },
  "Security": {
    "AllowedOrigins": [ "https://cameras.example.com" ]
  },
  "Gateway": {
    "Name": "",
    "Location": "Local"
  },
  "DataProtection": {
    "KeysDirectory": "data/keys"
  },
  "Discovery": {
    "Timeout": "00:00:03"
  }
}
