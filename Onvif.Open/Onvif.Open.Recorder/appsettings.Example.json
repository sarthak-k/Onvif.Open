{
  "Urls": "http://localhost:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Recording": {
    "StorageDirectory": "recordings",
    "Format": "MpegTs",
    "Rotation": {
      "SegmentDuration": "00:10:00",
      "MaxSegmentSizeMB": 512
    },
    "Retention": {
      "MaxAge": "7.00:00:00",
      "MaxSizePerCameraGB": 100,
      "MinFreeSpaceGB": 5
    },
    "RetentionInterval": "00:01:00",
    "StallTimeout": "00:00:15",
    "MinReconnectDelay": "00:00:01",
    "MaxReconnectDelay": "00:01:00",
    "Cameras": [
      {
        "Id": "front-door",
        "Enabled": true,
        "OnvifUrl": "http://192.168.1.10",
        "Username": "admin",
        "Password": "",
        "ProfileToken": "",
        "Transport": "Rtsp"
      },
      {
        "Id": "garage",
        "Enabled": true,
        "RtspUrl": "rtsp://192.168.1.11:554/Streaming/Channels/101",
        "Username": "admin",
        "Password": "",
        "Transport": "Udp",
        "Rotation": {
          "AlignToClock": "01:00:00"
        }
      },
      {
        "Id": "parking",
        "Enabled": true,
        "OnvifUrl": "http://192.168.1.12",
        "Username": "admin",
        "Password": "",
        "Mode": "Triggered",
        "PreRoll": "00:00:05",
        "PostRoll": "00:00:10",
        "Events": {
          "Enabled": true,
          "TriggerTopics": [
            "RuleEngine/CellMotionDetector/Motion"
          ]
        }
      }
    ]
  },
  "Plugins": {
    "Directory": "plugins",
    "FrameQueueCapacity": 32,
    "EventHistory": 1000,
    "StopTimeout": "00:00:10",
    "Items": {
      "Onvif.Open.Plugins.Sample": {
        "Enabled": true,
        "Cameras": [
          "front-door"
        ],
        "Settings": {
          "ReportEveryFrames": "100"
        }
      }
    }
  },
  "Discovery": {
    "Timeout": "00:00:03",
    "Multicast": true,
    "Targets": [
      "10.0.5.20"
    ]
  }
}
