<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Onvif.Open.Recorder</RootNamespace>
    <AssemblyName>Onvif.Open.Recorder</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Settings database: SQLite by default, or the user's SQL Server, PostgreSQL or MySQL ("Database:Provider"). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <!-- The database drivers bring 9.0.11, which has known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Onvif.Open.Camera\Onvif.Open.Camera.csproj" />
    <ProjectReference Include="..\Onvif.Open.Discovery\Onvif.Open.Discovery.csproj" />
    <ProjectReference Include="..\Onvif.Open.Plugins\Onvif.Open.Plugins.csproj" />
    <ProjectReference Include="..\Onvif.Open.Recording\Onvif.Open.Recording.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference configuration only: copy the cameras you need into appsettings.json. -->
    <Content Update="appsettings.Example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Onvif.Open.Test.Recording" />
  </ItemGroup>

</Project>
