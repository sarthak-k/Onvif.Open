{
  "Urls": "http://localhost:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Recording": {
    "StorageDirectory": "recordings",
    "Format": "MpegTs",
    "Rotation": {
      "SegmentDuration": "00:10:00",
      "MaxSegmentSizeMB": 512
    },
    "Archive": {
      "MaxConcurrentUploads": 2
    },
    "RetentionInterval": "00:01:00",
    "StallTimeout": "00:00:15",
    "MinReconnectDelay": "00:00:01",
    "MaxReconnectDelay": "00:01:00"
  },
  "Plugins": {
    "Directory": "plugins",
    "FrameQueueCapacity": 32,
    "EventHistory": 1000,
    "StopTimeout": "00:00:10"
  },
  "LiveView": {
    "SegmentDuration": "00:00:02",
    "WindowSize": 6,
    "IdleTimeout": "00:01:00",
    "StartTimeout": "00:00:15"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/onvif-open.db"
  },
  "Security": {
    "InitialAdmin": { "UserName": "admin", "Password": "" },
    "AllowedOrigins": [],
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "MaxFailedLogins": 5,
    "LockoutDuration": "00:05:00",
    "SignInsPerMinute": 10
  },
  "Export": {
    "Ffmpeg": "ffmpeg",
    "Directory": "data/exports"
  },
  "Gateway": {
    "Name": "",
    "Location": "Local"
  },
  "DataProtection": {
    "KeysDirectory": "data/keys"
  },
  "Discovery": {
    "Timeout": "00:00:03"
  }
}
