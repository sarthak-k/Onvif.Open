<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Storage plugin. Deploy the publish output as plugins/Onvif.Open.Storage.Gcs/ and set
    "Recording:Archive:Provider" to "Onvif.Open.Storage.Gcs" (see docs/STORAGE.md).
  -->
  <PropertyGroup>
    <RootNamespace>Onvif.Open.Storage.Gcs</RootNamespace>
    <AssemblyName>Onvif.Open.Storage.Gcs</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Onvif.Open.Test.Storage" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK contracts are provided by the host. -->
    <ProjectReference Include="..\Onvif.Open.Models\Onvif.Open.Core.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
