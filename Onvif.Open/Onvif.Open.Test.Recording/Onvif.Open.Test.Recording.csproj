<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Onvif.Open.Test.Recording</RootNamespace>
    <AssemblyName>Onvif.Open.Test.Recording</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The camera tests' RTSP server, for the connection test of the configuration API. -->
    <Compile Include="..\Onvif.Open.Test.Camera\Fakes\FakeRtspServer.cs" Link="Fakes\FakeRtspServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Onvif.Open.Models\Onvif.Open.Core.csproj" />
    <ProjectReference Include="..\Onvif.Open.Recorder\Onvif.Open.Recorder.csproj" />
    <ProjectReference Include="..\Onvif.Open.Recording\Onvif.Open.Recording.csproj" />
  </ItemGroup>

</Project>
